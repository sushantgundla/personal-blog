648},"independenceDate":"1968-09-06T00:00:00Z","officialLanguages":["English","Swazi"],"currencyName":"lilangeni","currencyCode":"SZL","drivingSide":"left","callingCode":"+268","licencePlateCode":"SD","topLevelDomain":".sz","highestPoint":{"name":"Emlembe","elevationM":1862},"lowestPoint":{"name":"Maputo River","elevationM":21},"patronSaints":[],"unescoSites":[],"neighbours":[{"iso3":"MOZ","name":"Mozambique","flagImageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag%20of%20Mozambique.svg?width=64"},{"iso3":"ZAF","name":"South Africa","flagImageUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag%20of%20South%20Africa.svg?width=64"}]}},"wikipedia":{"ok":true,"data":{"title":"Eswatini","extract":"Eswatini, formally the Kingdom of Eswatini, also known by its former official names Swaziland and the Kingdom of Swaziland, is a landlocked country in Southern Africa. It is bordered by South Africa on all sides except the east, where it shares a border with Mozambique. At no more than 200 km (120 mi) north to south and 130 km (81 mi) east to west, Eswatini is the second smallest country in Africa. However, its climate and topography are diverse, ranging from a cool and mountainous highveld to a hot and dry lowveld. The executive capital and largest city is Mbabane, and the legislative and second capital is Lobamba.","description":"Country in Southern Africa","thumbnailUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Flag_of_Eswatini.svg/330px-Flag_of_Eswatini.svg.png","canonicalUrl":"https://en.wikipedia.org/wiki/Eswatini","revisionTimestamp":"2026-07-24T06:35:40Z"}},"trade":{"ok":false,"reason":"Comtrade HTTP 429 for reporter 748 flow X"},"weather":{"ok":true,"data":{"temperatureC":10.3,"windKph":5.7,"observedAt":"2026-08-02T20:30"}},"fx":{"ok":false,"reason":"SZL not covered by Frankfurter"},"famousPeople":{"ok":true,"data":[]},"overrides":{},"capturedAt":"2026-08-02T20:43:37.180Z"}