i/Special:FilePath/Coat%20of%20arms%20of%20Tonga.svg?width=320","capital":"Nukuʻalofa","capitalCoordinates":{"lng":-175.201808,"lat":-21.1343401},"independenceDate":"1970-01-01T00:00:00Z","officialLanguages":["English","Tongan"],"currencyName":"Tongan paʻanga","currencyCode":"TOP","drivingSide":"left","callingCode":"+676","licencePlateCode":null,"topLevelDomain":".to","highestPoint":{"name":"Kao","elevationM":1030},"lowestPoint":{"name":"Pacific Ocean","elevationM":0},"patronSaints":[],"unescoSites":[],"neighbours":[]}},"wikipedia":{"ok":true,"data":{"title":"Tonga","extract":"Tonga, officially known as the Kingdom of Tonga, is an island country in Polynesia, part of Oceania. The country has 171 islands, of which 45 are inhabited. Its total surface area is about 750 km2 (290 sq mi), scattered over 700,000 km2 (270,000 sq mi) in the southern Pacific Ocean. As of 2021, according to Johnson's Tribune, Tonga has a population of 104,494, 70% of whom live on the main island, Tongatapu. The country stretches approximately 800 km north-south. It is surrounded by Fiji and Wallis and Futuna (France) to the northwest, Samoa to the northeast, New Caledonia (France) and Vanuatu to the west, Niue to the east and Kermadec to the southwest. Tonga is about 1,800 km from New Zealand's North Island.","description":"Country in Oceania","thumbnailUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Flag_of_Tonga.svg/330px-Flag_of_Tonga.svg.png","canonicalUrl":"https://en.wikipedia.org/wiki/Tonga","revisionTimestamp":"2026-08-01T15:04:11Z"}},"trade":{"ok":false,"reason":"Comtrade HTTP 429 for reporter 776 flow X"},"weather":{"ok":true,"data":{"temperatureC":22.2,"windKph":21.6,"observedAt":"2026-08-02T23:45"}},"fx":{"ok":false,"reason":"TOP not covered by Frankfurter"},"famousPeople":{"ok":true,"data":[]},"overrides":{},"capturedAt":"2026-08-02T23:50:26.317Z"}